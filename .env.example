# Copy this file to apps/api/.env for API configuration.
# API listener:
PORT=3000
# Vite development proxy target (server-side configuration, not a secret):
API_URL=http://127.0.0.1:3000
# SQLite path, resolved relative to the repository root:
DATABASE_PATH=./data/nexa.db
# Agent provider. Botpress is the application default; fake is reserved for automated tests:
AGENT_PROVIDER=botpress
# Required for Botpress. Keep real values outside Git:
BOTPRESS_TOKEN=
BOTPRESS_BOT_ID=
# Optional integration name filter. Omit to use the most recently active Runtime conversation context:
BOTPRESS_INTEGRATION_NAME=
# Optional development-only connectivity diagnostic. Disabled by default; values are public and must never contain credentials:
VITE_ENABLE_BOTPRESS_WEBCHAT=false
VITE_BOTPRESS_WEBCHAT_LOADER_URL=https://cdn.botpress.cloud/webchat/v5.0/inject.js
VITE_BOTPRESS_WEBCHAT_CONFIG_URL=https://files.bpcontent.cloud/2026/09/07/05/20260907050425-4X01JZLE.js
