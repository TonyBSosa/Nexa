{
  "name": "@nexa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test test/agent.test.ts test/botpress.test.ts test/knowledge.test.ts test/operations.test.ts",
    "smoke:botpress": "node --env-file-if-exists=.env --import tsx src/integrations/agent/botpress/smoke.ts",
    "start": "node --env-file-if-exists=.env dist/server.js"
  },
  "dependencies": {
    "@botpress/client": "^2.4.0",
    "@nexa/shared": "0.0.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "tsx": "^4.0.0"
  }
}
